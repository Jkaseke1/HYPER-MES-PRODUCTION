# PlantControl Production bridge configuration
# Copy to bridge/.env only on the Production application server.

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Production rollout scope: GRNs and material receipts only.
BRIDGE_ALLOWED_EVENT_TYPES=grn_confirmed,material_transfer_to_production,supplier_return
BRIDGE_ENFORCE_GRN_ONLY=false
BRIDGE_ENFORCE_SAGE_IDENTITY=true
BRIDGE_POLL_INTERVAL_MS=5000

# Preflight and rehearsal mode. The worker only reports queued GRNs and does
# not claim events, update sync_log, post to Sage, or replace opening balances.
DRY_RUN=true
SAGE_STOCK_SYNC_ENABLED=false

# Optional read-only Sage transporter-cost reconciliation. This only imports
# approved PostAP records into PlantControl; it cannot post or pay in Sage.
SAGE_TRANSPORT_COST_SYNC_ENABLED=false
SAGE_TRANSPORT_COST_SYNC_INTERVAL_MS=900000
SAGE_TRANSPORT_COST_SYNC_LOOKBACK_DAYS=120

# Optional read-only Sage customer master pull for CRM. It reads only the Sage
# customer master into PlantControl and is disabled until its audit migration
# is applied. CRM-owned notes, health, ownership and next actions are kept.
SAGE_CRM_CUSTOMER_SYNC_ENABLED=false
SAGE_CRM_CUSTOMER_SYNC_INTERVAL_MS=21600000
# Optional ISO-8601 cursor for a controlled incremental pull. Leave blank for
# the first full reconciliation.
SAGE_CRM_CUSTOMER_CHANGED_SINCE=

# The Sage SDK API is local to the Production application server.
SAGE_SDK_API_BASE_URL=http://127.0.0.1:5090
SAGE_SDK_API_KEY=your-production-sdk-api-key

# The preflight stops if the SDK is still connected to UAT or another company.
SAGE_EXPECTED_ENVIRONMENT=Production
SAGE_EXPECTED_COMPANY_DATABASE=Hyperfeeds 2024

# Sage SQL Server connection used by the optional master sync.
# Use the named instance from SSMS, or use SAGE_SERVER plus SAGE_PORT for a
# fixed TCP endpoint. Leave the port empty for a named SQL instance.
SAGE_SERVER=HYPERFEEDSSVR\\HYPERFEEDSSQL
SAGE_PORT=
SAGE_DATABASE=Hyperfeeds 2024
SAGE_USER=
SAGE_PASSWORD=

# Optional read-only Sage inventory master sync. It imports/updates item code,
# name, description, Sage code, and unit. It never deletes PlantControl items
# or changes stock balances.
SAGE_MASTER_SYNC_ENABLED=false
SAGE_MASTER_SYNC_INTERVAL_MS=86400000
# Required scope: exact Sage codes and/or comma-separated code prefixes.
# Leave both empty to import nothing.
SAGE_MASTER_SYNC_CODES=
SAGE_MASTER_SYNC_PREFIXES=
# Opt in to packaging identified by its Sage item description. Packaging imports
# use the "units" measure and do not delete PlantControl materials.
SAGE_MASTER_SYNC_PACKAGING=false
# When true, add only Sage codes that do not already exist in PlantControl's
# code or sage_code fields. Intended for controlled one-time imports.
SAGE_MASTER_SYNC_MISSING_ONLY=false

# CRM customer master import classification. Sage remains authoritative for
# account/contact/credit fields; CRM-owned segmentation can be edited later.
# These regexes are only initial classification rules for the first import.
SAGE_CRM_SMALL_SCALE_PATTERN=small[- ]?scale|farmer|grower
SAGE_CRM_DEALER_PATTERN=dealer|agent|distributor

# Bridge behaviour
# Set DRY_RUN=true to log SQL without writing to Sage (safe for testing)
DRY_RUN=true

# Phased rollout safety gate. This deployment enables only GRNs and
# Production material receipts; all other Sage event types remain blocked.
BRIDGE_ALLOWED_EVENT_TYPES=grn_confirmed,material_transfer_to_production
BRIDGE_ENFORCE_SAGE_IDENTITY=true
SAGE_EXPECTED_ENVIRONMENT=UAT
SAGE_EXPECTED_COMPANY_DATABASE=Hyperfeeds 2026 UAT

# Read-only Sage Vendor reconciliation for transporter requests raised at the
# weighbridge. This only updates PlantControl after Finance creates the Sage vendor.
SAGE_TRANSPORTER_SYNC_ENABLED=false
SAGE_TRANSPORTER_SYNC_INTERVAL_MS=900000
