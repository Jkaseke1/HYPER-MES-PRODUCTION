# PlantControl Production bridge configuration
# Copy to bridge/.env only on the Production application server.

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Production rollout scope: GRNs and material receipts only.
BRIDGE_ALLOWED_EVENT_TYPES=grn_confirmed,material_transfer_to_production,supplier_return
BRIDGE_ENFORCE_GRN_ONLY=false
BRIDGE_ENFORCE_SAGE_IDENTITY=true
BRIDGE_POLL_INTERVAL_MS=5000

# Preflight and rehearsal mode. The worker only reports queued GRNs and does
# not claim events, update sync_log, post to Sage, or replace opening balances.
DRY_RUN=true
SAGE_STOCK_SYNC_ENABLED=false

# The Sage SDK API is local to the Production application server.
SAGE_SDK_API_BASE_URL=http://127.0.0.1:5090
SAGE_SDK_API_KEY=your-production-sdk-api-key

# The preflight stops if the SDK is still connected to UAT or another company.
SAGE_EXPECTED_ENVIRONMENT=Production
SAGE_EXPECTED_COMPANY_DATABASE=Hyperfeeds 2024

# Sage SQL Server connection used by the optional master sync.
# Use the named instance from SSMS, or use SAGE_SERVER plus SAGE_PORT for a
# fixed TCP endpoint. Leave the port empty for a named SQL instance.
SAGE_SERVER=HYPERFEEDSSVR\\HYPERFEEDSSQL
SAGE_PORT=
SAGE_DATABASE=Hyperfeeds 2024
SAGE_USER=
SAGE_PASSWORD=

# Optional read-only Sage inventory master sync. It imports/updates item code,
# name, description, Sage code, and unit. It never deletes PlantControl items
# or changes stock balances.
SAGE_MASTER_SYNC_ENABLED=false
SAGE_MASTER_SYNC_INTERVAL_MS=86400000
# Required scope: exact Sage codes and/or comma-separated code prefixes.
# Leave both empty to import nothing.
SAGE_MASTER_SYNC_CODES=
SAGE_MASTER_SYNC_PREFIXES=
